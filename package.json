{
  "name": "mona-expert",
  "version": "2.0.0",
  "description": "mona-agent — cloud-brained AI agent for your device. Open-source client: device daemon, terminal UI, local tools. Connects to the mona.expert cloud (agent.mona.expert).",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/engine",
    "packages/protocol",
    "apps/desktop"
  ],
  "bin": {
    "mona-agent": "./apps/desktop/bin/mona-agent.js"
  },
  "scripts": {
    "start": "node apps/desktop/bin/mona-agent.js start",
    "gui": "node apps/desktop/bin/mona-agent.js gui",
    "login": "node apps/desktop/bin/mona-agent.js login",
    "test": "node --test apps/desktop/test/agent.test.mjs apps/desktop/test/control.test.mjs apps/desktop/test/docker-control.test.mjs apps/desktop/test/tui-scroll.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MONAEXPERT/agent.git"
  },
  "keywords": [
    "ai-agent",
    "device-daemon",
    "cloud-brain",
    "terminal-ui",
    "mona-expert"
  ]
}
