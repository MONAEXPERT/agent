{
  "name": "mona-agent",
  "version": "1.2.0",
  "description": "Cloud-brained device agent with terminal dashboard. Multi-OS (macOS/Linux/Windows). No local LLM keys.",
  "type": "module",
  "bin": {
    "mona-agent": "./bin/mona-agent.js"
  },
  "scripts": {
    "start": "node bin/mona-agent.js start",
    "gui": "node bin/mona-agent.js gui",
    "login": "node bin/mona-agent.js login",
    "test": "node --test test/agent.test.mjs test/control.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MONAEXPERT/mona-agent.git"
  },
  "keywords": [
    "ai-agent",
    "device-daemon",
    "cloud-brain",
    "terminal-ui",
    "openclaw"
  ]
}
