{
  "name": "mona-expert",
  "version": "2.0.0",
  "description": "mona.expert — merged enterprise monorepo: device agent, control plane, cloud brain. One key (mona.expert), one brain (mona.expert engine).",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "platform"
  ],
  "bin": {
    "mona-agent": "./bin/mona-agent.js"
  },
  "scripts": {
    "start": "node bin/mona-agent.js start",
    "gui": "node bin/mona-agent.js gui",
    "login": "node bin/mona-agent.js login",
    "test": "node --test test/agent.test.mjs test/control.test.mjs test/docker-control.test.mjs test/tui-scroll.test.mjs",
    "migrate": "node scripts/migrate.mjs",
    "setup": "node scripts/setup.mjs",
    "seed": "node scripts/seed.mjs",
    "keygen": "node scripts/keygen.mjs",
    "emit:mysql": "node database/migrations/emit-mysql.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MONAEXPERT/agent.git"
  },
  "keywords": [
    "ai-agent",
    "device-daemon",
    "cloud-brain",
    "terminal-ui",
    "control-plane",
    "enterprise",
    "mona-expert"
  ]
}
